# OpenClaw Backup - .gitignore

## Sensitive
*.json
*.token
*.key
*.pem
*.crt
.env
.env.*
secrets/
credentials/

## Cache & Temp
node_modules/
.cache/
tmp/
temp/
*.log

## IDE
.vscode/
.idea/
*.swp
*.swo

## OS
.DS_Store
Thumbs.db

## OpenClaw Specific
.openclaw/sessions/
.openclaw/logs/
*.sock

# Skills (reinstallable)
skills/

## Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
stock_monitor/stock_data.db
